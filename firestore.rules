rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 1. Primitives & Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn(); }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- 2. Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'displayName', 'createdAt'])
        && data.uid == request.auth.uid
        && data.email == request.auth.token.email
        && data.role in ['artisan', 'client']
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && (data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 1000)
        && (data.get('bio', '') is string && data.get('bio', '').size() <= 2000)
        && (data.get('location', '') is string && data.get('location', '').size() <= 200)
        && (data.get('skills', []) is list && data.get('skills', []).size() <= 50)
        && (data.get('portfolio', []) is list && data.get('portfolio', []).size() <= 20)
        && (data.get('rating', 0) is number)
        && (data.get('reviewCount', 0) is int)
        && data.createdAt is timestamp;
    }

    function isValidServiceRequest(data) {
      return data.keys().hasAll(['clientId', 'title', 'description', 'category', 'status', 'createdAt'])
        && data.clientId == request.auth.uid
        && data.title is string && data.title.size() >= 5 && data.title.size() <= 200
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 5000
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && (data.get('budget', 0) is number && data.get('budget', 0) >= 0)
        && (data.get('location', '') is string && data.get('location', '').size() <= 200)
        && (data.get('urgency', 'medium') in ['low', 'medium', 'high', 'emergency'])
        && data.status in ['pending', 'assigned', 'completed', 'cancelled']
        && data.createdAt is timestamp;
    }

    function isValidProposal(data) {
      return data.keys().hasAll(['requestId', 'artisanId', 'clientId', 'price', 'status', 'createdAt'])
        && data.artisanId == request.auth.uid
        && isValidId(data.requestId)
        && isValidId(data.clientId)
        && data.price is number && data.price >= 0
        && (data.get('estimatedDays', 0) is int && data.get('estimatedDays', 0) >= 0)
        && (data.get('message', '') is string && data.get('message', '').size() <= 2000)
        && data.status in ['pending', 'accepted', 'rejected']
        && data.createdAt is timestamp;
    }

    function isValidChat(data) {
      return data.keys().hasAll(['participants', 'updatedAt'])
        && data.participants is list && data.participants.size() == 2
        && request.auth.uid in data.participants
        && (data.get('lastMessage', '') is string && data.get('lastMessage', '').size() <= 1000)
        && (data.get('requestId', '') is string && (data.get('requestId', '').size() == 0 || isValidId(data.requestId)))
        && data.updatedAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'text', 'createdAt'])
        && data.senderId == request.auth.uid
        && data.text is string && data.text.size() > 0 && data.text.size() <= 5000
        && data.createdAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['targetUserId', 'authorId', 'requestId', 'rating', 'role', 'createdAt'])
        && data.authorId == request.auth.uid
        && isValidId(data.targetUserId)
        && isValidId(data.requestId)
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.role in ['artisan', 'client']
        && (data.get('comment', '') is string && data.get('comment', '').size() <= 2000)
        && data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'type', 'read', 'createdAt'])
        && isValidId(data.userId)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.message is string && data.message.size() > 0 && data.message.size() <= 1000
        && data.type in ['quote', 'message', 'status_update', 'reminder', 'info']
        && data.read is bool
        && (data.get('actionLink', '') is string && data.get('actionLink', '').size() <= 1000)
        && data.createdAt is timestamp;
    }

    // --- 3. Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn() || resource.data.role == 'artisan';
      allow list: if isSignedIn() || resource.data.role == 'artisan';
      allow create: if isVerified() && isOwner(userId) && isValidUser(incoming());
      allow update: if isVerified() && isOwner(userId) && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().email == existing().email
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'location', 'skills', 'portfolio', 'rating', 'reviewCount', 'updatedAt'])
        && (incoming().get('updatedAt', request.time) is timestamp);
    }

    match /requests/{requestId} {
      allow get: if isSignedIn() || resource.data.status == 'pending';
      allow list: if isSignedIn() || resource.data.status == 'pending';
      allow create: if isVerified() && isValidServiceRequest(incoming());
      allow update: if isVerified() && (
        // Action: Client Edit
        (isOwner(existing().clientId) && existing().status == 'pending' && isValidServiceRequest(incoming())
         && incoming().clientId == existing().clientId
         && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'budget', 'location', 'urgency', 'status', 'assignedArtisanId', 'updatedAt'])
         && (incoming().get('updatedAt', request.time) is timestamp)) ||
        // Action: Client Assign/Cancel
        (isOwner(existing().clientId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'assignedArtisanId', 'updatedAt'])
         && (incoming().get('updatedAt', request.time) is timestamp)) ||
        // Action: Artisan Complete
        (isOwner(existing().assignedArtisanId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
         && incoming().status == 'completed'
         && (incoming().get('updatedAt', request.time) is timestamp))
      );
      allow delete: if isVerified() && isOwner(existing().clientId) && existing().status == 'pending';
    }

    match /proposals/{proposalId} {
      allow get: if isSignedIn() && (isOwner(existing().artisanId) || isOwner(existing().clientId));
      allow list: if isSignedIn() && (resource.data.artisanId == request.auth.uid || resource.data.clientId == request.auth.uid);
      allow create: if isVerified() && isValidProposal(incoming())
        && exists(/databases/$(database)/documents/requests/$(incoming().requestId))
        && get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.status == 'pending';
      allow update: if isVerified() && (
        // Action: Artisan Edit Proposal
        (isOwner(existing().artisanId) && existing().status == 'pending' && isValidProposal(incoming())
         && incoming().requestId == existing().requestId
         && incoming().clientId == existing().clientId
         && incoming().diff(existing()).affectedKeys().hasOnly(['price', 'estimatedDays', 'message', 'updatedAt'])
         && (incoming().get('updatedAt', request.time) is timestamp)) ||
        // Action: Client Accept/Reject
        (isOwner(existing().clientId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
         && incoming().status in ['accepted', 'rejected']
         && (incoming().get('updatedAt', request.time) is timestamp))
      );
      allow delete: if isVerified() && isOwner(existing().artisanId) && existing().status == 'pending';
    }

    match /chats/{chatId} {
      allow get: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isVerified() && isValidChat(incoming())
        && request.auth.uid in incoming().participants;
      allow update: if isVerified() && request.auth.uid in existing().participants
        && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])
        && incoming().updatedAt is timestamp;

      match /messages/{messageId} {
        allow get: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow list: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isVerified() && isValidMessage(incoming())
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    match /reviews/{reviewId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isVerified() && isValidReview(incoming())
        && !exists(/databases/$(database)/documents/reviews/$(reviewId))
        && exists(/databases/$(database)/documents/requests/$(incoming().requestId))
        && (
          (
            request.auth.uid == get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.clientId
            && incoming().targetUserId == get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.assignedArtisanId
          ) || (
            request.auth.uid == get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.assignedArtisanId
            && incoming().targetUserId == get(/databases/$(database)/documents/requests/$(incoming().requestId)).data.clientId
          )
        );
    }

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isVerified() && isValidNotification(incoming());
      allow update: if isOwner(resource.data.userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt'])
        && (incoming().get('updatedAt', request.time) is timestamp);
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
