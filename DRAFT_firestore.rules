rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- User Validation ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'displayName', 'createdAt'])
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.role in ['artisan', 'client']
        && data.displayName is string && data.displayName.size() <= 100
        && data.createdAt == request.time;
    }

    // --- ServiceRequest Validation ---
    function isValidServiceRequest(data) {
      return data.keys().hasAll(['clientId', 'title', 'description', 'category', 'status', 'createdAt'])
        && data.clientId == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.category is string && data.category.size() <= 100
        && data.status in ['pending', 'assigned', 'completed', 'cancelled']
        && data.createdAt == request.time;
    }

    // --- Proposal Validation ---
    function isValidProposal(data) {
      return data.keys().hasAll(['requestId', 'artisanId', 'clientId', 'price', 'status', 'createdAt'])
        && data.artisanId == request.auth.uid
        && data.requestId is string && data.requestId.size() <= 128
        && data.clientId is string && data.clientId.size() <= 128
        && data.price is number && data.price >= 0
        && data.status in ['pending', 'accepted', 'rejected']
        && data.createdAt == request.time;
    }

    // --- Review Validation ---
    function isValidReview(data) {
      return data.keys().hasAll(['targetUserId', 'authorId', 'requestId', 'rating', 'role', 'createdAt'])
        && data.authorId == request.auth.uid
        && data.targetUserId is string && data.targetUserId.size() <= 128
        && data.requestId is string && data.requestId.size() <= 128
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.role in ['artisan', 'client']
        && data.createdAt == request.time;
    }

    // --- Collections ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'location', 'skills', 'portfolio', 'rating', 'reviewCount']);
    }

    match /requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidServiceRequest(incoming());
      allow update: if isSignedIn() && (
        // Client updates their own request
        (isOwner(existing().clientId) && isValidServiceRequest(incoming()) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'budget', 'location', 'urgency', 'status', 'assignedArtisanId', 'updatedAt'])
         && incoming().updatedAt == request.time)
      );
      allow delete: if isOwner(existing().clientId) && existing().status == 'pending';
    }

    match /proposals/{proposalId} {
      allow read: if isSignedIn() && (isOwner(existing().artisanId) || isOwner(existing().clientId));
      allow create: if isSignedIn() && isValidProposal(incoming()) 
        && exists(/databases/$(database)/documents/requests/$(incoming().requestId));
      allow update: if isSignedIn() && (
        // Artisan updates their proposal (e.g. price change while pending)
        (isOwner(existing().artisanId) && isValidProposal(incoming()) && existing().status == 'pending'
         && incoming().diff(existing()).affectedKeys().hasOnly(['price', 'estimatedDays', 'message'])) ||
        // Client accepts/rejects
        (isOwner(existing().clientId) && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
         && incoming().status in ['accepted', 'rejected'])
      );
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in incoming().participants;
      allow update: if isSignedIn() && request.auth.uid in existing().participants
        && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])
        && incoming().updatedAt == request.time;

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && incoming().senderId == request.auth.uid
          && incoming().createdAt == request.time;
      }
    }

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidReview(incoming())
        && !exists(/databases/$(database)/documents/reviews/$(reviewId)); // Simple check for individual review docs
    }
  }
}
