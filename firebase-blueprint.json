{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents both artisans and clients in the system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["artisan", "client"] },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "location": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "portfolio": { "type": "array", "items": { "type": "string" } },
        "rating": { "type": "number" },
        "reviewCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "displayName"]
    },
    "ServiceRequest": {
      "title": "Service Request",
      "description": "A job request posted by a client.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "budget": { "type": "number" },
        "location": { "type": "string" },
        "urgency": { "type": "string", "enum": ["low", "medium", "high", "emergency"] },
        "status": { "type": "string", "enum": ["pending", "assigned", "completed", "cancelled"] },
        "assignedArtisanId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "title", "description", "category", "status", "createdAt"]
    },
    "Proposal": {
      "title": "Proposal",
      "description": "A quote sent by an artisan for a service request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requestId": { "type": "string" },
        "artisanId": { "type": "string" },
        "clientId": { "type": "string" },
        "price": { "type": "number" },
        "estimatedDays": { "type": "integer" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["requestId", "artisanId", "clientId", "price", "status", "createdAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "A conversation between a client and an artisan.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "requestId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A single message within a chat.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "text", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "A bilateral review between client and artisan.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetUserId": { "type": "string" },
        "authorId": { "type": "string" },
        "requestId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "role": { "type": "string", "enum": ["artisan", "client"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["targetUserId", "authorId", "requestId", "rating", "role", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System notification for a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["quote", "message", "status_update", "reminder", "info"] },
        "read": { "type": "boolean" },
        "actionLink": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles for artisans and clients."
    },
    "/requests/{requestId}": {
      "schema": "ServiceRequest",
      "description": "Jobs posted by clients."
    },
    "/proposals/{proposalId}": {
      "schema": "Proposal",
      "description": "Quotes submitted by artisans."
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Messaging threads."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Individual messages in a thread."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Ratings and feedback."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications."
    }
  }
}
